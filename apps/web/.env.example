# Public URL of this web app (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Same cloud name as the API; used by the next/image Cloudinary loader (not secret)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# URL of the Express API. Server components call it directly and next.config rewrites
# /api/v1/* to it, so browser cookies stay first-party. Server-only, never exposed.
API_INTERNAL_URL=http://localhost:4000
# Must equal REVALIDATE_SECRET in apps/api
REVALIDATE_SECRET=
