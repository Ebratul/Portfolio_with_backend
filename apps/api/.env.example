# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# Local: `docker compose up -d` (set POSTGRES_PORT if 5432 is taken and use that port below).
# Neon / hosted: use the DIRECT (non-pooled) connection string; it works for both the server and migrations.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public

# ---- Auth: generate each with `openssl rand -base64 48` (min 32 chars, must differ) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Cloudinary (Console -> Settings -> API Keys). Server-side only. ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Seed-only admin credentials (used by `pnpm db:seed`; password min 10 chars) ----
# ADMIN_PASSWORD is only read by the seed; you can delete it from the server afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- GitHub contribution graph (fine-grained token, public read is enough). Optional. ----
GITHUB_TOKEN=

# ---- Contact email notifications. Optional: without either option messages are only stored. ----
# Option A (recommended for hosting): Resend HTTPS API. Works where SMTP ports are blocked (Render free plan).
# Free key at https://resend.com. With the default sender below, mail can only go to YOUR Resend account email.
RESEND_API_KEY=
MAIL_FROM=
# Option B: SMTP (e.g. Gmail app password). Used only when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio <no-reply@example.com>"

# ---- Web app origin for CORS and revalidation calls (no trailing slash) ----
WEB_ORIGIN=http://localhost:3000
# Shared secret for POST {WEB_ORIGIN}/api/revalidate; must equal REVALIDATE_SECRET in apps/web
REVALIDATE_SECRET=

# Proxies in front of the API. Local dev: 1. Vercel rewrite -> Render/Railway: 2.
# Verify after deploy: a contact message's stored IP must be the visitor's, not your host's.
TRUST_PROXY_HOPS=1

LOG_LEVEL=info
